// MAFK-24/7 Retail-Flow POS - PostgreSQL schema (Prisma 7)
//
// Conventions
//  * Every tenant-owned table carries `tenantId`.
//  * Parents expose @@unique([id, tenantId]) and children reference (fk, tenantId) so the
//    DATABASE itself rejects any cross-tenant relationship (defence in depth on top of
//    server-side tenant scoping).
//  * Money:     Decimal(18,2) totals/payments, Decimal(18,4) unit prices/costs.
//    Quantity:  Decimal(14,3). Percent: Decimal(7,4). No floats anywhere.
//  * Financial/history rows are never hard-deleted (Restrict). Users/products are soft-deleted.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum SystemRole {
  MASTER_ADMIN
  CLIENT_MASTER_ADMIN
  MANAGER
  CASHIER
  INVENTORY_STAFF
  CUSTOM
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum DeviceStatus {
  ACTIVE
  BLOCKED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CUSTOMER_CREDIT
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

enum PurchaseStatus {
  RECORDED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum DocumentType {
  SALE
  SALE_RETURN
  PURCHASE
}

// ───────────────────────────── Platform / tenancy ─────────────────────────────

model Tenant {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  legalName    String?
  contactEmail String?
  contactPhone String?
  address      String?
  logoUrl      String?
  currency     String       @default("PKR")
  timezone     String       @default("Asia/Karachi")
  status       TenantStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  stores            Store[]
  roles             Role[]
  users             User[]
  licenses          License[]
  devices           Device[]
  sessions          Session[]
  brands            Brand[]
  categories        Category[]
  subDepartments    SubDepartment[]
  products          Product[]
  barcodes          Barcode[]
  inventories       Inventory[]
  inventoryMoves    InventoryMovement[]
  customers         Customer[]
  customerPayments  CustomerPayment[]
  suppliers         Supplier[]
  supplierPayments  SupplierPayment[]
  sales             Sale[]
  vouchers          Voucher[]
  cashActivities    CashActivity[]
  saleItems         SaleItem[]
  payments          Payment[]
  saleReturns       SaleReturn[]
  saleReturnItems   SaleReturnItem[]
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  expenses          Expense[]
  employees         Employee[]
  settings          Setting[]
  auditLogs         AuditLog[]
  loginIdHistory    LoginIdHistory[]
  documentSequences DocumentSequence[]
  userCategories    UserCategory[]
  smsLogs           SmsLog[]
  overheadRuns      OverheadRun[]

  @@map("tenants")
}

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  address   String?
  phone     String?
  isDefault Boolean  @default(false)
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  cashActivities    CashActivity[]
  users             User[]
  devices           Device[]
  inventories       Inventory[]
  inventoryMoves    InventoryMovement[]
  sales             Sale[]
  saleReturns       SaleReturn[]
  purchases         Purchase[]
  expenses          Expense[]
  employees         Employee[]
  documentSequences DocumentSequence[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("stores")
}

model License {
  id             String        @id @default(cuid())
  tenantId       String
  planCode       String
  licenseKey     String        @unique
  status         LicenseStatus @default(ACTIVE)
  startsAt       DateTime      @default(now())
  expiresAt      DateTime
  maxUsers       Int
  maxDevices     Int
  maxStores      Int
  enabledModules String[]
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, expiresAt])
  @@map("licenses")
}

model Device {
  id              String       @id @default(cuid())
  tenantId        String
  storeId         String?
  name            String
  fingerprintHash String
  status          DeviceStatus @default(ACTIVE)
  registeredAt    DateTime     @default(now())
  lastSeenAt      DateTime?
  updatedAt       DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  store    Store?    @relation(fields: [storeId, tenantId], references: [id, tenantId])
  sessions Session[]
  sales    Sale[]

  @@unique([tenantId, fingerprintHash])
  @@unique([id, tenantId])
  @@map("devices")
}

// ───────────────────────────── Identity / RBAC ─────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

// tenantId is NULL only for the platform MASTER_ADMIN role. Every client tenant owns its own role rows.
model Role {
  id          String     @id @default(cuid())
  tenantId    String?
  key         String
  name        String
  description String?
  systemRole  SystemRole
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, key])
  @@unique([id, tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(cuid())
  tenantId           String?
  storeId            String?
  roleId             String
  loginId            String     @unique // stored normalised (lower-case)
  displayName        String
  email              String?
  phone              String?
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  /// Sale > User PC Serial: when set, this ID can only sign in from the PC with exactly this serial.
  pcSerial           String?
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdById        String?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant         Tenant?            @relation(fields: [tenantId], references: [id])
  store          Store?             @relation(fields: [storeId, tenantId], references: [id, tenantId])
  // Plain FK on purpose: a composite (roleId, tenantId) relation cannot join for platform users, whose tenantId is NULL
  // (the Master Admin would load with role = null). Tenant/role consistency is enforced in provisioning + services.
  role           Role               @relation(fields: [roleId], references: [id])
  employee       Employee?
  sessions       Session[]
  loginIdChanges LoginIdHistory[]   @relation("LoginIdHistoryUser")
  profile        UserProfile?
  moduleAccess   UserModuleAccess[]
  itemRights     UserItemRight[]

  @@unique([id, tenantId])
  @@index([tenantId, roleId])
  @@index([tenantId, status])
  @@map("users")
}

// Every Login ID change is recorded. Business records reference User.id (immutable), never loginId,
// so history stays linked to the original identity.
model LoginIdHistory {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String
  oldLoginId  String
  newLoginId  String
  changedById String
  reason      String?
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation("LoginIdHistoryUser", fields: [userId], references: [id])

  @@index([oldLoginId])
  @@index([userId, createdAt])
  @@map("login_id_history")
}

model Session {
  id                       String    @id @default(cuid())
  userId                   String
  tenantId                 String?
  deviceId                 String?
  refreshTokenHash         String    @unique
  previousRefreshTokenHash String?   @unique
  userAgent                String?
  ipAddress                String?
  createdAt                DateTime  @default(now())
  lastUsedAt               DateTime  @default(now())
  expiresAt                DateTime
  revokedAt                DateTime?
  revokedReason            String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  device Device? @relation(fields: [deviceId, tenantId], references: [id, tenantId])

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id            String   @id @default(cuid())
  loginId       String
  userId        String?
  tenantId      String?
  ipAddress     String?
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([loginId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Brand {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@map("brands")
}

model Category {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  subDepartments SubDepartment[]
  products       Product[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@map("categories")
}

model SubDepartment {
  id          String       @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  category           Category  @relation(fields: [categoryId, tenantId], references: [id, tenantId])
  products           Product[]
  productsInCategory Product[] @relation("ProductSubDeptCategory")

  @@unique([categoryId, name])
  @@unique([id, tenantId])
  @@unique([id, categoryId]) // lets Product prove its sub-department belongs to its category
  @@map("sub_departments")
}

model Product {
  id              String       @id @default(cuid())
  tenantId        String
  name            String
  sku             String
  categoryId      String
  subDepartmentId String
  brandId         String?
  supplierId      String?
  costPrice       Decimal      @db.Decimal(18, 4)
  sellingPrice    Decimal      @db.Decimal(18, 4)
  wholesalePrice  Decimal?     @db.Decimal(18, 4)
  taxRate         Decimal      @default(0) @db.Decimal(7, 4)
  unit            String       @default("pcs")
  minStock        Decimal      @default(0) @db.Decimal(14, 3)
  maxStock        Decimal?     @db.Decimal(14, 3)
  trackInventory  Boolean      @default(true)
  imageUrl        String?
  description     String?
  status          RecordStatus @default(ACTIVE)
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  category          Category      @relation(fields: [categoryId, tenantId], references: [id, tenantId])
  subDepartment     SubDepartment @relation(fields: [subDepartmentId, tenantId], references: [id, tenantId], map: "products_subdept_tenant_fkey")
  subDeptInCategory SubDepartment @relation("ProductSubDeptCategory", fields: [subDepartmentId, categoryId], references: [id, categoryId], map: "products_subdept_category_fkey")
  brand             Brand?        @relation(fields: [brandId, tenantId], references: [id, tenantId])
  supplier          Supplier?     @relation(fields: [supplierId, tenantId], references: [id, tenantId])

  barcodes        Barcode[]
  inventories     Inventory[]
  inventoryMoves  InventoryMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  saleReturnItems SaleReturnItem[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId, name])
  @@index([tenantId, categoryId, subDepartmentId])
  @@map("products")
}

model Barcode {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  code      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([productId])
  @@map("barcodes")
}

// ───────────────────────────── Inventory ─────────────────────────────

model Inventory {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  store   Store   @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@unique([storeId, productId])
  @@index([tenantId, productId])
  @@map("inventory")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  tenantId       String
  storeId        String
  productId      String
  type           InventoryMovementType
  quantityChange Decimal               @db.Decimal(14, 3)
  balanceAfter   Decimal               @db.Decimal(14, 3)
  unitCost       Decimal?              @db.Decimal(18, 4)
  referenceType  String?
  referenceId    String?
  reason         String?
  createdById    String?
  createdAt      DateTime              @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  store   Store   @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, storeId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ───────────────────────────── Parties ─────────────────────────────

model Customer {
  id             String       @id @default(cuid())
  tenantId       String
  name           String
  phone          String?
  email          String?
  address        String?
  customerType   CustomerType @default(RETAIL)
  openingBalance Decimal      @default(0) @db.Decimal(18, 2)
  creditLimit    Decimal?     @db.Decimal(18, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  sales    Sale[]
  payments CustomerPayment[]

  @@unique([id, tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

model CustomerPayment {
  id          String        @id @default(cuid())
  tenantId    String
  customerId  String
  amount      Decimal       @db.Decimal(18, 2)
  method      PaymentMethod
  reference   String?
  note        String?
  paidAt      DateTime      @default(now())
  createdById String?
  createdAt   DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId, tenantId], references: [id, tenantId])

  @@index([tenantId, customerId, paidAt])
  @@map("customer_payments")
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  phone          String?
  email          String?
  address        String?
  contactPerson  String?
  taxNumber      String?
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  products  Product[]
  purchases Purchase[]
  payments  SupplierPayment[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@map("suppliers")
}

model SupplierPayment {
  id          String        @id @default(cuid())
  tenantId    String
  supplierId  String
  purchaseId  String?
  amount      Decimal       @db.Decimal(18, 2)
  method      PaymentMethod
  reference   String?
  note        String?
  paidAt      DateTime      @default(now())
  createdById String?
  createdAt   DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  supplier Supplier  @relation(fields: [supplierId, tenantId], references: [id, tenantId])
  purchase Purchase? @relation(fields: [purchaseId, tenantId], references: [id, tenantId])

  @@index([tenantId, supplierId, paidAt])
  @@map("supplier_payments")
}

// ───────────────────────────── Sales ─────────────────────────────

model Sale {
  id                    String     @id @default(cuid())
  tenantId              String
  storeId               String
  invoiceNo             String
  clientRequestId       String? // idempotency key (double-submit / future offline sync)
  customerId            String?
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  cashierId             String
  deviceId              String?
  status                SaleStatus @default(COMPLETED)
  subtotal              Decimal    @db.Decimal(18, 2)
  itemDiscountTotal     Decimal    @default(0) @db.Decimal(18, 2)
  cartDiscountPercent   Decimal    @default(0) @db.Decimal(7, 4)
  cartDiscountAmount    Decimal    @default(0) @db.Decimal(18, 2)
  taxTotal              Decimal    @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal    @db.Decimal(18, 2)
  paidTotal             Decimal    @db.Decimal(18, 2)
  changeDue             Decimal    @default(0) @db.Decimal(18, 2)
  notes                 String?
  // POS extras (reference POS screen): document references, charges on top of the lines, rounding, redeemed vouchers.
  orderRef              String?
  fbrInvoiceNo          String?
  creditNoteRef         String?
  serviceFee            Decimal    @default(0) @db.Decimal(18, 2)
  otherCharges          Decimal    @default(0) @db.Decimal(18, 2)
  roundingAmount        Decimal    @default(0) @db.Decimal(18, 2)
  voucherAmount         Decimal    @default(0) @db.Decimal(18, 2)
  voucherRefs           String?
  soldAt                DateTime   @default(now())
  voidedAt              DateTime?
  voidedById            String?
  voidReason            String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  store    Store     @relation(fields: [storeId, tenantId], references: [id, tenantId])
  customer Customer? @relation(fields: [customerId, tenantId], references: [id, tenantId])
  device   Device?   @relation(fields: [deviceId, tenantId], references: [id, tenantId])

  items    SaleItem[]
  payments Payment[]
  returns  SaleReturn[]

  @@unique([tenantId, invoiceNo])
  @@unique([tenantId, clientRequestId])
  @@unique([id, tenantId])
  @@index([tenantId, soldAt])
  @@index([tenantId, cashierId, soldAt])
  @@index([tenantId, customerId])
  @@map("sales")
}

model SaleItem {
  id               String  @id @default(cuid())
  tenantId         String
  saleId           String
  productId        String
  productName      String
  sku              String
  quantity         Decimal @db.Decimal(14, 3)
  returnedQuantity Decimal @default(0) @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(18, 4)
  unitCost         Decimal @db.Decimal(18, 4)
  discountPercent  Decimal @default(0) @db.Decimal(7, 4)
  discountAmount   Decimal @default(0) @db.Decimal(18, 2)
  taxRate          Decimal @default(0) @db.Decimal(7, 4)
  taxAmount        Decimal @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal @db.Decimal(18, 2)
  salesman         String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  sale    Sale    @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product Product @relation(fields: [productId, tenantId], references: [id, tenantId])

  returnItems SaleReturnItem[]

  @@unique([id, tenantId])
  @@index([saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(18, 2)
  reference String?
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sale   Sale   @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([saleId])
  @@index([tenantId, method, createdAt])
  @@map("payments")
}

model SaleReturn {
  id            String        @id @default(cuid())
  tenantId      String
  storeId       String
  saleId        String
  returnNo      String
  processedById String
  refundMethod  PaymentMethod
  refundTotal   Decimal       @db.Decimal(18, 2)
  reason        String?
  createdAt     DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId, tenantId], references: [id, tenantId])
  sale   Sale   @relation(fields: [saleId, tenantId], references: [id, tenantId])

  items SaleReturnItem[]

  @@unique([tenantId, returnNo])
  @@unique([id, tenantId])
  @@index([tenantId, saleId])
  @@index([tenantId, createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @default(cuid())
  tenantId     String
  saleReturnId String
  saleItemId   String
  productId    String
  quantity     Decimal @db.Decimal(14, 3)
  unitRefund   Decimal @db.Decimal(18, 4)
  lineTotal    Decimal @db.Decimal(18, 2)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  saleReturn SaleReturn @relation(fields: [saleReturnId, tenantId], references: [id, tenantId], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId, tenantId], references: [id, tenantId])
  product    Product    @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

// ───────────────────────────── Purchases ─────────────────────────────

model Purchase {
  id              String         @id @default(cuid())
  tenantId        String
  storeId         String
  supplierId      String
  purchaseNo      String
  invoiceNo       String
  purchaseDate    DateTime
  status          PurchaseStatus @default(RECORDED)
  subtotal        Decimal        @db.Decimal(18, 2)
  discountPercent Decimal        @default(0) @db.Decimal(7, 4)
  discountAmount  Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal        Decimal        @default(0) @db.Decimal(18, 2)
  total           Decimal        @db.Decimal(18, 2)
  paidAmount      Decimal        @default(0) @db.Decimal(18, 2)
  paymentStatus   PaymentStatus  @default(UNPAID)
  notes           String?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  store    Store    @relation(fields: [storeId, tenantId], references: [id, tenantId])
  supplier Supplier @relation(fields: [supplierId, tenantId], references: [id, tenantId])

  items    PurchaseItem[]
  payments SupplierPayment[]

  @@unique([tenantId, storeId, purchaseNo])
  @@unique([tenantId, supplierId, invoiceNo])
  @@unique([id, tenantId])
  @@index([tenantId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id              String  @id @default(cuid())
  tenantId        String
  purchaseId      String
  productId       String
  quantity        Decimal @db.Decimal(14, 3)
  costPrice       Decimal @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @db.Decimal(7, 4)
  discountAmount  Decimal @default(0) @db.Decimal(18, 2)
  taxRate         Decimal @default(0) @db.Decimal(7, 4)
  taxAmount       Decimal @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal @db.Decimal(18, 2)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  purchase Purchase @relation(fields: [purchaseId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product  Product  @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@index([purchaseId])
  @@index([tenantId, productId])
  @@map("purchase_items")
}

// ───────────────────────────── Operations ─────────────────────────────

model Expense {
  id          String        @id @default(cuid())
  tenantId    String
  storeId     String
  category    String
  description String?
  amount      Decimal       @db.Decimal(18, 2)
  expenseDate DateTime
  method      PaymentMethod
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId, tenantId], references: [id, tenantId])

  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
  @@map("expenses")
}

// Identity data (login) lives on User. Employee links to a User when the employee can log in.
model Employee {
  id          String         @id @default(cuid())
  tenantId    String
  userId      String?        @unique
  storeId     String?
  fullName    String
  phone       String?
  designation String?
  nationalId  String?
  hireDate    DateTime?
  salary      Decimal?       @db.Decimal(18, 2)
  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  store  Store? @relation(fields: [storeId, tenantId], references: [id, tenantId])

  @@index([tenantId, status])
  @@map("employees")
}

model Setting {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("settings")
}

model DocumentSequence {
  id        String       @id @default(cuid())
  tenantId  String
  storeId   String?
  type      DocumentType
  prefix    String
  nextValue Int          @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store? @relation(fields: [storeId, tenantId], references: [id, tenantId])

  @@unique([tenantId, storeId, type])
  @@map("document_sequences")
}

// Append-only (DB trigger rejects UPDATE/DELETE - see migration).
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ── Administrator module ─────────────────────────────────────────────────────────────────────────────────────────────
// Security File: which modules (Checks Approval) and which forms/reports with Access/Add/Edit/Delete a user may use.
// The saved rights are turned into permission keys on the user's private CUSTOM role (see AdminSecurityService), so the
// existing requirePermission() checks enforce them.
model UserCategory {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  profiles UserProfile[]

  @@unique([tenantId, code])
  @@map("user_categories")
}

model UserProfile {
  userId         String   @id
  tenantId       String
  fbrPosId       String?
  macAddress     String?
  userCategoryId String?
  counterPos     String?
  port           Int?
  fbrToken       String?
  pcSerial       String?
  updatedAt      DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category UserCategory? @relation(fields: [userCategoryId], references: [id])

  @@index([tenantId])
  @@map("user_profiles")
}

model UserModuleAccess {
  userId    String
  tenantId  String
  moduleKey String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleKey])
  @@index([tenantId])
  @@map("user_module_access")
}

model UserItemRight {
  userId    String
  tenantId  String
  itemKey   String
  canAccess Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemKey])
  @@index([tenantId])
  @@map("user_item_rights")
}

// Written by whatever sends SMS. The software has no SMS gateway yet, so this stays empty until one is connected.
model SmsLog {
  id          String   @id @default(cuid())
  tenantId    String
  recipient   String
  message     String
  status      String
  error       String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("sms_logs")
}

model OverheadRun {
  id            String   @id @default(cuid())
  tenantId      String
  periodFrom    DateTime @db.Date
  periodTo      DateTime @db.Date
  totalExpenses Decimal  @db.Decimal(18, 2)
  totalSales    Decimal  @db.Decimal(18, 2)
  ratePercent   Decimal  @db.Decimal(9, 4)
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("overhead_runs")
}

// ───────────────────────────── Vouchers ─────────────────────────────

enum VoucherKind {
  DISCOUNT
  CREDIT_MEMO
}

enum VoucherStatus {
  ACTIVE
  USED
  CANCELLED
}

/// A discount voucher or a credit memo: a code worth `balance`, redeemed (fully or partly) against a sale.
model Voucher {
  id         String        @id @default(cuid())
  tenantId   String
  code       String
  kind       VoucherKind
  amount     Decimal       @db.Decimal(18, 2)
  balance    Decimal       @db.Decimal(18, 2)
  status     VoucherStatus @default(ACTIVE)
  expiresAt  DateTime?
  note       String?
  issuedById String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, kind, status])
  @@map("vouchers")
}

// ───────────────────────────── Sale menu ─────────────────────────────

/// Daily Cash Activity: one sheet per shop per business day. All money figures are computed by the API from the day's
/// bills and the detail lines; `closed` locks the sheet (and Cash/Card Update of that day's bills).
model CashActivity {
  id               String    @id @default(cuid())
  tenantId         String
  storeId          String
  businessDate     String // YYYY-MM-DD in the tenant's time zone
  openingPettyCash Decimal   @default(0) @db.Decimal(18, 2)
  receivePettyCash Decimal   @default(0) @db.Decimal(18, 2)
  totalExpense     Decimal   @default(0) @db.Decimal(18, 2)
  closingPettyCash Decimal   @default(0) @db.Decimal(18, 2)
  creditCardSales  Decimal   @default(0) @db.Decimal(18, 2)
  onAccountSales   Decimal   @default(0) @db.Decimal(18, 2)
  cashSales        Decimal   @default(0) @db.Decimal(18, 2)
  redemptionAmount Decimal   @default(0) @db.Decimal(18, 2)
  totalSales       Decimal   @default(0) @db.Decimal(18, 2)
  openingCash      Decimal   @default(0) @db.Decimal(18, 2)
  adjustment       Decimal   @default(0) @db.Decimal(18, 2)
  totalAvailable   Decimal   @default(0) @db.Decimal(18, 2)
  depositedCash    Decimal   @default(0) @db.Decimal(18, 2)
  netAvailable     Decimal   @default(0) @db.Decimal(18, 2)
  expenseLines     Json      @default("[]")
  receiptLines     Json      @default("[]")
  transferLines    Json      @default("[]")
  terminalLines    Json      @default("[]")
  voucherNo        String?
  closed           Boolean   @default(false)
  closedAt         DateTime?
  closedById       String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId, tenantId], references: [id, tenantId])

  @@unique([tenantId, storeId, businessDate])
  @@index([tenantId, businessDate])
  @@map("cash_activities")
}
